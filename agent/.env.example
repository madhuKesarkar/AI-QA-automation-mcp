# Copy this file to .env in the repo root and fill in real values.
# Never commit the real .env.

# Required
LINEAR_API_KEY=...          # fetch ticket, post comments, apply labels (Linear Settings > API)
ANTHROPIC_API_KEY=...       # Claude calls for requirements-reviewer, test-planner, bug-analyser
SANDBOX_URL=https://schools.sandbox.bwtest.net
QA_URL=https://schools.qa.bwtest.net

# Optional — Slack notifications (status-reporter agent)
SLACK_WEBHOOK_URL=...       # Incoming Webhook URL from Slack App config

# Optional — Google Docs fetching (requirements-reviewer agent)
# Works for publicly shared docs. Private docs need a service-account OAuth flow (future work).
GOOGLE_DOCS_API_KEY=...     # Google Cloud API key with Docs API enabled

# Optional — webhook server (bw-qa-loop webhook command)
WEBHOOK_PORT=3456           # Port for the Linear webhook receiver
LINEAR_WEBHOOK_SECRET=...   # From Linear Settings > API > Webhooks — validates HMAC signatures

# Optional — misc
MAX_ROUNDS=3                # Infra-retry rounds before giving up
GIT_USER_NAME=bw-qa-loop-bot
GIT_USER_EMAIL=qa-bot@example.com
