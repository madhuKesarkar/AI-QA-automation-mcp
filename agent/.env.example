# Copy this file to .env in the repo root and fill in real values.
# Never commit the real .env.

LINEAR_API_KEY=...          # fetch the ticket, post comments, apply labels (personal API key from Linear Settings > API)
ANTHROPIC_API_KEY=...       # scenario-writer stage's Claude calls
SANDBOX_URL=https://schools.sandbox.bwtest.net
QA_URL=https://schools.qa.bwtest.net

# optional
MAX_ROUNDS=3                # how many infra-retry rounds before giving up (see runner.ts)
GIT_USER_NAME=bw-qa-loop-bot
GIT_USER_EMAIL=qa-bot@example.com
